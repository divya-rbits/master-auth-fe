# API Configuration
# Development: Use HTTP with localhost
# Production: Use HTTPS (automatically enforced in production builds)
# Examples:
#   Development: http://localhost:11557
#   Production:  https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:11557

VITE_APPLICATION_ID=master-password-auth

# Frontend URL - Used by 3rd party apps for cross-subdomain authentication
# Examples:
#   Development: http://localhost:11556
#   Production:  https://masterfrontend.reversebits.tech
# Note: This app runs on port 11556 (both local and Docker)
VITE_FRONTEND_URL=https://masterfrontend.reversebits.tech

# Security Configuration
# Set to 'true' to enforce strict application ID validation (recommended for production)
# Set to 'false' to log warnings but allow access (useful for development)
VITE_STRICT_APP_ID_CHECK=false

# Note: HTTPS enforcement happens automatically in production builds
# - Localhost always allows HTTP (for development)
# - Production builds warn/upgrade HTTP to HTTPS for security
